{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "propuesta-ui.schema.json",
  "title": "Contrato servidor ↔ navegador",
  "description": "Dos formas: 'Propuesta' es lo que devuelve POST /compras/documentos/{token}/interpretar; 'PropuestaConfirmada' es lo que acepta POST /compras/documentos/{token}/crear. Importes y flags derivados solo viajan en la primera dirección: al crear, el servidor los ignora y recalcula (Principio III).",
  "$defs": {
    "Propuesta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "archivo_nombre", "formato", "proveedor", "numero_documento", "fecha", "notas", "lineas", "campos_ilegibles", "avisos", "totales", "total_documento"],
      "properties": {
        "token": { "type": "string", "format": "uuid" },
        "archivo_nombre": { "type": "string", "description": "Nombre original: identifica el documento en la cola y en los errores (FR-009, FR-034)." },
        "formato": { "enum": ["pdf", "imagen"] },
        "proveedor": { "$ref": "#/$defs/EmparejamientoProveedor" },
        "numero_documento": { "type": ["string", "null"] },
        "fecha": { "type": ["string", "null"], "format": "date" },
        "notas": { "type": ["string", "null"] },
        "lineas": { "type": "array", "items": { "$ref": "#/$defs/LineaPropuesta" } },
        "campos_ilegibles": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Rutas de campos que el modelo no pudo leer, p. ej. 'fecha' o 'lineas.2.tipo_impositivo'. La UI los marca visualmente (FR-010)."
        },
        "avisos": { "type": "array", "items": { "$ref": "#/$defs/Aviso" } },
        "totales": { "$ref": "#/$defs/Totales" },
        "total_documento": { "type": ["number", "null"], "description": "Lo que decía el documento, para que el usuario vea la discrepancia con los totales recalculados." }
      }
    },

    "EmparejamientoProveedor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterio", "proveedor_id", "proveedor_nombre", "similitud", "datos_nuevos"],
      "properties": {
        "criterio": {
          "enum": ["nif", "nombre", "sin_coincidencia"],
          "description": "'nif' = reconocido por identificación fiscal, preseleccionado. 'nombre' = SUGERENCIA a confirmar. 'sin_coincidencia' = hay que elegir uno o crear (FR-018)."
        },
        "proveedor_id": { "type": ["integer", "null"] },
        "proveedor_nombre": { "type": ["string", "null"] },
        "similitud": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "datos_nuevos": {
          "type": ["object", "null"],
          "description": "Datos del emisor leídos del documento, editables, para el alta opcional del proveedor. Presente cuando criterio = 'sin_coincidencia'.",
          "additionalProperties": false,
          "required": ["nombre", "razon_social", "nif", "direccion", "cp", "ciudad", "provincia", "pais", "email", "telefono"],
          "properties": {
            "nombre": { "type": ["string", "null"] },
            "razon_social": { "type": ["string", "null"] },
            "nif": { "type": ["string", "null"] },
            "direccion": { "type": ["string", "null"] },
            "cp": { "type": ["string", "null"] },
            "ciudad": { "type": ["string", "null"] },
            "provincia": { "type": ["string", "null"] },
            "pais": { "type": ["string", "null"] },
            "email": { "type": ["string", "null"] },
            "telefono": { "type": ["string", "null"] }
          }
        }
      }
    },

    "LineaPropuesta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concepto", "referencia", "unidad", "cantidad", "precio_unitario", "tipo_impositivo", "tipo_impositivo_coherente", "articulo", "base", "cuota_impuesto"],
      "properties": {
        "concepto": { "type": "string" },
        "referencia": { "type": ["string", "null"] },
        "unidad": { "type": ["string", "null"] },
        "cantidad": { "type": ["number", "null"] },
        "precio_unitario": { "type": ["number", "null"] },
        "tipo_impositivo": { "type": ["number", "null"], "description": "Null si el documento no lo indicaba. La UI lo pide antes de permitir crear; nunca se rellena con 21 por defecto (Principio II)." },
        "tipo_impositivo_coherente": { "type": "boolean", "description": "false si el tipo no es válido para el régimen impositivo del tenant (IVA/IGIC/IPSI). Se señala, no bloquea (FR-028)." },
        "articulo": { "$ref": "#/$defs/EmparejamientoArticulo" },
        "base": { "type": ["number", "null"], "description": "Calculado en servidor. Informativo." },
        "cuota_impuesto": { "type": ["number", "null"], "description": "Calculado en servidor. Informativo." }
      }
    },

    "EmparejamientoArticulo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterio", "articulo_id", "articulo_nombre", "similitud", "mueve_stock"],
      "properties": {
        "criterio": { "enum": ["referencia", "nombre", "sin_coincidencia"] },
        "articulo_id": { "type": ["integer", "null"], "description": "null = línea libre; resultado válido, no bloquea (FR-023)." },
        "articulo_nombre": { "type": ["string", "null"] },
        "similitud": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "mueve_stock": { "type": "boolean", "description": "true si el artículo es producto con gestión de stock: al confirmar la compra, esta línea moverá inventario." }
      }
    },

    "Aviso": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo", "mensaje", "url"],
      "properties": {
        "tipo": { "enum": ["posible_duplicado", "moneda_no_eur", "tipo_impositivo_incoherente", "totales_no_cuadran", "campos_ilegibles"] },
        "mensaje": { "type": "string" },
        "url": { "type": ["string", "null"], "description": "Enlace a la compra existente en el caso de posible_duplicado." }
      }
    },

    "Totales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_total", "cuota_impuesto_total", "total"],
      "properties": {
        "base_total": { "type": "number" },
        "cuota_impuesto_total": { "type": "number" },
        "total": { "type": "number" }
      }
    },

    "PropuestaConfirmada": {
      "type": "object",
      "description": "Body de POST /compras/documentos/{token}/crear. Deliberadamente NO incluye importes calculados ni flags derivados: el servidor los recalcula desde cantidad, precio_unitario y tipo_impositivo.",
      "additionalProperties": false,
      "required": ["proveedor_id", "crear_proveedor", "proveedor_nuevo", "numero_documento", "fecha", "notas", "confirmar_duplicado", "lineas"],
      "properties": {
        "proveedor_id": { "type": ["integer", "null"], "description": "Requerido salvo que crear_proveedor sea true. Se revalida contra el tenant activo." },
        "crear_proveedor": { "type": "boolean" },
        "proveedor_nuevo": {
          "type": ["object", "null"],
          "description": "Solo si crear_proveedor es true. 'nombre' obligatorio; el resto opcional.",
          "additionalProperties": false,
          "required": ["nombre"],
          "properties": {
            "nombre": { "type": "string" },
            "razon_social": { "type": ["string", "null"] },
            "nif": { "type": ["string", "null"] },
            "direccion": { "type": ["string", "null"] },
            "cp": { "type": ["string", "null"] },
            "ciudad": { "type": ["string", "null"] },
            "provincia": { "type": ["string", "null"] },
            "pais": { "type": ["string", "null"] },
            "email": { "type": ["string", "null"] },
            "telefono": { "type": ["string", "null"] }
          }
        },
        "numero_documento": { "type": ["string", "null"], "maxLength": 255 },
        "fecha": { "type": "string", "format": "date" },
        "notas": { "type": ["string", "null"] },
        "confirmar_duplicado": { "type": "boolean", "description": "true para crear pese al aviso de duplicado (FR-031: avisa, no bloquea)." },
        "lineas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["articulo_id", "concepto", "unidad", "cantidad", "precio_unitario", "tipo_impositivo"],
            "properties": {
              "articulo_id": { "type": ["integer", "null"] },
              "concepto": { "type": "string", "maxLength": 255 },
              "unidad": { "type": ["string", "null"], "maxLength": 20 },
              "cantidad": { "type": "number", "exclusiveMinimum": 0 },
              "precio_unitario": { "type": "number", "minimum": 0 },
              "tipo_impositivo": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
